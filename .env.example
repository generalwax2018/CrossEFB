# Copy these into the host's environment (Vercel, a server, or a local .env).
# Do not commit real values. This file stays empty on purpose.
#
# Whoever hosts a copy of CrossEFB gets their own FAA NOTAM API credentials
# and adds them here. The project does not ship a key. Without these two,
# the app still runs and NOTAMs stay off.

FAA_NOTAM_CLIENT_ID=
FAA_NOTAM_CLIENT_SECRET=

# Optional. Leave unset to use the current FAA NOTAM API.
# FAA_NOTAM_API_URL=

# Optional. Postgres for encrypted sync. Without it, a local database is used.
# DATABASE_URL=

# Flight plans are not filed from this app. Do not put a Leidos or 1800wxbrief
# password here. A vendor account does not exist yet. See README, Flight plan filing.
